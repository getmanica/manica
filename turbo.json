{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"],
      "env": ["VITE_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "lint": {},
    "test": {
      "passThroughEnv": ["DATABASE_URL"]
    },
    "format": {
      "cache": false
    },
    "format:check": {},
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
