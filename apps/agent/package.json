{
  "name": "agent",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cargo build --release --locked && mkdir -p dist && cp target/release/manica-agent dist/manica-agent",
    "check-types": "cargo check --all-targets --locked && tsc",
    "format": "cargo fmt && biome format --write",
    "format:check": "cargo fmt --check && biome format",
    "lint": "cargo clippy --all-targets --locked -- -D warnings && biome lint",
    "start": "cargo run --release --",
    "test": "cargo test --locked"
  },
  "devDependencies": {
    "@manica/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
