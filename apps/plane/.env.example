PORT=3000
# The `postgres` service in the root compose.yaml
DATABASE_URL=postgres://manica:manica@localhost:5432/manica
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL forges deliver webhooks to (defaults to BETTER_AUTH_URL); must be
# publicly reachable. In development, run a tunnel that forwards every path
# (smee.io doesn't: each app has its own webhook path), e.g.
#   cloudflared tunnel --url http://localhost:3000
# and set this to the URL it prints.
# PUBLIC_URL=
# Encrypts forge app credentials at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Optional: lets users sign in with GitHub. Create a GitHub OAuth app (not
# a GitHub App) with the callback URL $BETTER_AUTH_URL/api/auth/callback/github.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional: turns on billing through Stripe (self-hosted planes rarely need
# it). Point a Stripe webhook at $BETTER_AUTH_URL/api/auth/stripe/webhook with
# the checkout.session.completed and customer.subscription.* events, and set
# its signing secret. Plans and their limits are managed in Admin > Plans.
# Users manage payment and cancel through a customer portal configuration
# plane creates in Stripe (tagged `manica-plane`), without plan switching:
# they change plans from the console, where disabled plans aren't offered,
# and plane switches the subscription's price itself. No portal setup needed.
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
